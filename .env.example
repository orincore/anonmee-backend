DATABASE_URL=postgresql://anonme:anonme_dev@localhost:5433/anonme
REDIS_URL=redis://localhost:6380
JWT_ACCESS_SECRET=change-me-min-32-chars-change-me-min-32
JWT_REFRESH_SECRET=change-me-too-min-32-chars-change-me-too
# Production: https://anonmee.in (the API on a subdomain such as https://api.anonmee.in keeps cookies same-site)
WEB_ORIGIN=http://localhost:3000
SERVER_PORT=4000
ADMIN_JWT_SECRET=change-me-admin-session-secret-32-chars-min
ADMIN_ENC_KEY=change-me-admin-2fa-encryption-key-32-chars-min
PUBLIC_API_URL=http://localhost:4000
DB_POOL_MAX=20
# Set to true ONLY when running behind a reverse proxy you control
TRUST_PROXY=false
# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-smtp-login
SMTP_PASS=your-brevo-smtp-key
SMTP_FROM=Anonmee <no-reply@anonmee.orincore.com>
TOGETHER_API_KEY=your-together-api-key
TOGETHER_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017
# AI companions: kill switch, daily token budget (hard stop, UTC day), and optional pause above N real people online (0 = no limit)
BOTS_ENABLED=true
BOTS_DAILY_TOKEN_BUDGET=2000000
BOTS_MAX_HUMANS_ONLINE=0
